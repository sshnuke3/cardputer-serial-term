# Cardputer-ADV (ESP32-S3FN8, 8MB flash, 无 PSRAM)
# 目标芯片请用: idf.py set-target esp32s3

CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=n

# 主循环频率
CONFIG_FREERTOS_HZ=1000

# Arduino 组件
CONFIG_ARDUINO_RUNNING_CORE=1
CONFIG_ARDUINO_LOOP_STACK_SIZE=32768

# USB: 主机模式 —— Cardputer 当 USB 主机，直连开发板的 USB-CDC(CDC-ACM)
# 必须关闭设备 CDC(ARDUINO_USB_CDC_ON_BOOT / TINYUSB_CDC_ENABLED)，
# 把唯一的 USB 外设让给主机，否则 tinyusb_host_init 会与设备模式冲突。
CONFIG_TINYUSB=y
CONFIG_TINYUSB_HOST_ENABLED=y
CONFIG_TINYUSB_HOST_CDC=y
CONFIG_TINYUSB_HOST_HID=n
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_ARDUINO_USB_CDC_ON_BOOT=n
CONFIG_USB_OTG_ENABLE=y

# 看门狗超时放宽，避免偶尔阻塞误触
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
