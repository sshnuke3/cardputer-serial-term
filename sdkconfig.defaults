# Cardputer-ADV (ESP32-S3FN8, 8MB flash, 无 PSRAM)
# 目标芯片请用: idf.py set-target esp32s3

CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
CONFIG_SPIRAM=n

# 主循环频率
CONFIG_FREERTOS_HZ=1000

# Arduino 组件 + 原生 USB CDC(PC 桥接走 USB-CDC 而非 UART0)
CONFIG_ARDUINO_USB_MODE=y
CONFIG_ARDUINO_USB_CDC_ON_BOOT=y
CONFIG_ARDUINO_RUNNING_CORE=1
CONFIG_ARDUINO_LOOP_STACK_SIZE=32768

# TinyUSB(Arduino USB 模式依赖)
CONFIG_TINYUSB=y
CONFIG_TINYUSB_CDC_ENABLED=y

# 看门狗超时放宽，避免偶尔阻塞误触
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
